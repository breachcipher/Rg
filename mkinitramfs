#!/bin/bash
# mkinitramfs for LFS Live ISO
# Compatible: Ventoy, Rufus, USB, CD/DVD, VirtualBox, VMware

# ===================== FUNCTIONS =====================

copy()
{
  local file

  if [ "$2" = "lib" ]; then
    file=$(PATH=/usr/lib type -p $1 2>/dev/null)
  else
    file=$(type -p $1 2>/dev/null)
  fi

  if [ -n "$file" ] ; then
    cp "$file" "$WDIR/usr/$2"
    echo "  Copied: $1 -> $WDIR/usr/$2"
  else
    echo "Warning: Missing file: $1"
  fi
}

# ===================== MAIN =====================

# Parse arguments
if [ -z "$1" ] ; then
  INITRAMFS_FILE="initrd.img-no-kmods"
  KERNEL_VERSION=""
else
  KERNEL_VERSION="$1"
  INITRAMFS_FILE="initrd.img-$KERNEL_VERSION"
fi

if [ -n "$KERNEL_VERSION" ] && [ ! -d "/lib/modules/$KERNEL_VERSION" ] ; then
  echo "ERROR: No modules directory: /lib/modules/$KERNEL_VERSION"
  exit 1
fi

printf "Creating $INITRAMFS_FILE... "

# ===================== BINARY LIST =====================

# Binaries wajib ada di initramfs
binfiles="sh bash cat cp dd killall ls mkdir mknod mount mountpoint"
binfiles="$binfiles umount ln rm uname readlink basename"
binfiles="$binfiles chmod chown find sleep echo printf"
binfiles="$binfiles lsblk sed grep awk dmesg ps kill"

sbinfiles="modprobe blkid switch_root losetup"

# udevd - cari di semua lokasi
for f in udevd systemd-udevd; do
  if   [ -x /usr/sbin/$f ]; then
    sbinfiles="$sbinfiles $f"
  elif [ -x /sbin/$f ]; then
    sbinfiles="$sbinfiles $f"
  elif [ -x /usr/lib/udev/$f ]; then
    sbinfiles="$sbinfiles $f"
  elif [ -x /lib/udev/$f ]; then
    sbinfiles="$sbinfiles $f"
  fi
done

# ===================== SETUP WORKDIR =====================

unsorted=$(mktemp /tmp/unsorted.XXXXXXXXXX)

DATADIR=/usr/share/mkinitramfs
INITIN=init.in

# Check if init script exists
if [ ! -f "$DATADIR/$INITIN" ]; then
  echo "ERROR: Init script not found at $DATADIR/$INITIN"
  echo "Please create $DATADIR/$INITIN first"
  exit 1
fi

WDIR=$(mktemp -d /tmp/initrd-work.XXXXXXXXXX)

# Buat struktur direktori lengkap
mkdir -p $WDIR/{dev,run,sys,proc,tmp,tmpmnt,usr/{bin,lib/{firmware,modules},sbin}}
mkdir -p $WDIR/{mnt,squash,cow,media,.root}
mkdir -p $WDIR/etc/{modprobe.d,udev/rules.d,ld.so.conf.d}

# Direktori untuk berbagai boot methods
mkdir -p $WDIR/cdrom
mkdir -p $WDIR/run/archiso/bootmnt
mkdir -p $WDIR/run/live/medium
mkdir -p $WDIR/media/ventoy
mkdir -p $WDIR/run/initramfs/live
mkdir -p $WDIR/run/boot-media

touch $WDIR/etc/modprobe.d/modprobe.conf

# ===================== CREATE ETC FILES =====================

# CREATE /etc/group - CRITICAL untuk udev
cat > $WDIR/etc/group << 'EOF'
root:x:0:
bin:x:1:
daemon:x:2:
sys:x:3:
adm:x:4:
tty:x:5:
disk:x:6:
lp:x:7:
mem:x:8:
kmem:x:9:
wheel:x:10:
floppy:x:11:
mail:x:12:
man:x:15:
dialout:x:18:
cdrom:x:19:
audio:x:20:
video:x:21:
netdev:x:22:
input:x:23:
tape:x:24:
users:x:100:
nogroup:x:65534:
systemd-journal:x:23:
EOF

# CREATE /etc/passwd untuk initramfs
cat > $WDIR/etc/passwd << 'EOF'
root:x:0:0:root:/root:/bin/sh
bin:x:1:1:bin:/bin:/sbin/nologin
daemon:x:2:2:daemon:/sbin:/sbin/nologin
nobody:x:65534:65534:nobody:/nonexistent:/sbin/nologin
EOF

# CREATE /etc/shadow
cat > $WDIR/etc/shadow << 'EOF'
root::19490:0:99999:7:::
EOF
chmod 600 $WDIR/etc/shadow

# CREATE /etc/passwd-
cat > $WDIR/etc/passwd- << 'EOF'
root:x:0:0:root:/root:/bin/sh
bin:x:1:1:bin:/bin:/sbin/nologin
daemon:x:2:2:daemon:/sbin:/sbin/nologin
nobody:x:65534:65534:nobody:/nonexistent:/sbin/nologin
EOF

# CREATE /etc/group-
cat > $WDIR/etc/group- << 'EOF'
root:x:0:
bin:x:1:
daemon:x:2:
sys:x:3:
adm:x:4:
tty:x:5:
disk:x:6:
lp:x:7:
mem:x:8:
kmem:x:9:
wheel:x:10:
floppy:x:11:
mail:x:12:
man:x:15:
dialout:x:18:
cdrom:x:19:
audio:x:20:
video:x:21:
netdev:x:22:
input:x:23:
tape:x:24:
users:x:100:
nogroup:x:65534:
EOF

# CREATE /etc/nsswitch.conf
cat > $WDIR/etc/nsswitch.conf << 'EOF'
passwd: files
group: files
shadow: files
hosts: files dns
networks: files
protocols: files
services: files
ethers: files
rpc: files
EOF

# udev config - disable problematic rules
cat > $WDIR/etc/udev/udev.conf << 'EOF'
udev_log=err
children_max=2
exec_delay=0
event_timeout=10
resolve_names=never
EOF

# Disable udev rules yang bermasalah
cat > $WDIR/etc/udev/rules.d/99-disable-problematic.rules << 'EOF'
# Disable rules that might cause issues in initramfs
ACTION=="add", SUBSYSTEM=="rtc", OPTIONS="ignore_device"
SUBSYSTEM=="sound", OPTIONS="ignore_device"
SUBSYSTEM=="drm", OPTIONS="ignore_device"
EOF

# Symlinks standar
ln -s usr/bin  $WDIR/bin
ln -s usr/lib  $WDIR/lib
ln -s usr/sbin $WDIR/sbin
ln -s lib      $WDIR/lib64

# ===================== DEVICE NODES =====================

# Device nodes minimal
mknod -m 640 $WDIR/dev/console c 5 1 2>/dev/null
mknod -m 664 $WDIR/dev/null    c 1 3 2>/dev/null
mknod -m 640 $WDIR/dev/kmsg    c 1 11 2>/dev/null

# Loop devices
for i in 0 1 2 3 4 5 6 7; do
  mknod -m 660 $WDIR/dev/loop$i b 7 $i 2>/dev/null
done

# ===================== INSTALL INIT SCRIPT =====================

install -m0755 $DATADIR/$INITIN $WDIR/init
echo "Installed init script"

if [ ! -f "$WDIR/init" ]; then
  echo "ERROR: Failed to install init script to $WDIR/init!"
  exit 1
fi

# ===================== INSTALL BINARIES =====================

echo "Installing binaries..."
for f in $binfiles ; do
  found=0
  for dir in /usr/bin /bin; do
    if [ -x "$dir/$f" ]; then
      ldd "$dir/$f" 2>/dev/null | sed "s/\t//" | cut -d " " -f1 >> $unsorted 2>/dev/null
      copy "$f" bin
      found=1
      break
    fi
  done
  if [ $found -eq 0 ]; then
    echo "Warning: $f not found"
  fi
done

echo "Installing sbinaries..."
for f in $sbinfiles ; do
  found=0
  for dir in /usr/sbin /sbin; do
    if [ -x "$dir/$f" ]; then
      ldd "$dir/$f" 2>/dev/null | sed "s/\t//" | cut -d " " -f1 >> $unsorted 2>/dev/null
      copy "$f" sbin
      found=1
      break
    fi
  done
  if [ $found -eq 0 ]; then
    echo "Warning: $f not found in sbin"
  fi
done

# ===================== INSTALL UDEV =====================

echo "Installing udev..."
UDEVD_FOUND=0

for udevd_path in \
  /usr/lib/udev/udevd \
  /lib/udev/udevd \
  /usr/lib/systemd/systemd-udevd \
  /lib/systemd/systemd-udevd \
  /usr/sbin/udevd \
  /sbin/udevd \
  /usr/bin/udevd
do
  if [ -x "$udevd_path" ]; then
    case "$udevd_path" in
      */udev/udevd)
        mkdir -p "$WDIR/usr/lib/udev"
        cp "$udevd_path" "$WDIR/usr/lib/udev/udevd"
        echo "  Copied udevd from $udevd_path"
        UDEVD_FOUND=1
        break
        ;;
      */systemd/*)
        mkdir -p "$WDIR/usr/lib/systemd"
        cp "$udevd_path" "$WDIR/usr/lib/systemd/systemd-udevd"
        echo "  Copied systemd-udevd"
        UDEVD_FOUND=1
        break
        ;;
      *)
        mkdir -p "$WDIR/usr/sbin"
        cp "$udevd_path" "$WDIR/usr/sbin/udevd"
        echo "  Copied udevd"
        UDEVD_FOUND=1
        break
        ;;
    esac
  fi
done

if [ $UDEVD_FOUND -eq 0 ]; then
  echo "WARNING: udevd not found!"
fi

# Copy udevadm
echo "Installing udevadm..."
for udevadm_path in /usr/sbin/udevadm /sbin/udevadm /bin/udevadm /usr/bin/udevadm; do
  if [ -x "$udevadm_path" ]; then
    mkdir -p "$WDIR/usr/bin"
    cp "$udevadm_path" "$WDIR/usr/bin/udevadm"
    echo "  Copied udevadm from $udevadm_path"
    break
  fi
done

# ===================== INSTALL LIBRARIES =====================

echo "Installing libraries..."
if [ -s "$unsorted" ]; then
  sort "$unsorted" | uniq | while read library ; do
    case "$library" in
      linux-vdso.so*|linux-gate.so*|libsystemd-shared*|ld-*)
        continue ;;
    esac

    lib_file=""
    for libdir in /usr/lib /lib /usr/lib64 /lib64 /usr/lib/x86_64-linux-gnu /lib/x86_64-linux-gnu; do
      if [ -f "$libdir/$library" ]; then
        lib_file="$libdir/$library"
        break
      fi
    done

    if [ -n "$lib_file" ]; then
      cp "$lib_file" "$WDIR/usr/lib/" 2>/dev/null
    fi
  done
fi

# ===================== INSTALL KERNEL MODULES =====================

if [ -n "$KERNEL_VERSION" ]; then
  echo "Installing kernel modules for $KERNEL_VERSION..."

  modules_needed="squashfs overlay loop vfat iso9660 isofs usb-storage sr_mod"
  modules_needed="$modules_needed xhci-hcd ehci-hcd uhci-hcd"
  modules_needed="$modules_needed exfat ntfs"
  modules_needed="$modules_needed virtio virtio_pci virtio_blk virtio_net"

  for mod in $modules_needed; do
    mod_path=$(find /lib/modules/$KERNEL_VERSION -name "${mod}.ko*" 2>/dev/null | head -1)
    if [ -n "$mod_path" ]; then
      mkdir -p "$WDIR/usr/lib/modules/$KERNEL_VERSION/$(dirname ${mod_path#/lib/modules/$KERNEL_VERSION/})"
      cp "$mod_path" "$WDIR/usr/lib/modules/$KERNEL_VERSION/${mod_path#/lib/modules/$KERNEL_VERSION/}"
      echo "  Added module: $mod"
    fi
  done

  mkdir -p $WDIR/usr/lib/modules/$KERNEL_VERSION
  for f in modules.dep modules.dep.bin modules.alias modules.alias.bin \
           modules.symbols modules.symbols.bin modules.builtin; do
    if [ -f "/lib/modules/$KERNEL_VERSION/$f" ]; then
      cp "/lib/modules/$KERNEL_VERSION/$f" "$WDIR/usr/lib/modules/$KERNEL_VERSION/" 2>/dev/null
    fi
  done

  mkdir -p $WDIR/lib/modules
  ln -sf /usr/lib/modules/$KERNEL_VERSION $WDIR/lib/modules/$KERNEL_VERSION 2>/dev/null

  depmod -b $WDIR $KERNEL_VERSION 2>/dev/null
  echo "Kernel modules installed"
fi

# ===================== CREATE INITRAMFS =====================

( cd $WDIR ; find . -print | cpio -o -H newc --quiet | gzip -9 ) > $INITRAMFS_FILE

SIZE=$(du -sh $INITRAMFS_FILE | cut -f1)
echo "done. (size: $SIZE)"

# ===================== VERIFICATION =====================

echo ""
echo "=== Verifying critical files ==="
for f in init etc/group etc/passwd usr/bin/sh usr/sbin/switch_root; do
  if [ -f "$WDIR/$f" ] || [ -L "$WDIR/$f" ]; then
    echo "  OK: $f"
  else
    echo "  MISSING: $f"
  fi
done

# Cleanup
rm -rf $WDIR $unsorted 2>/dev/null

echo ""
echo "Done! Initramfs created: $INITRAMFS_FILE"
