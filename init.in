#!/bin/sh
# Init script for custom LFS Live ISO - Coreutils version (no BusyBox)
# Auto-detect boot media, robust /proc mount handling
# Compatible with: VirtualBox, VMware, Ventoy, Rufus, CD/DVD, USB

PATH=/usr/bin:/usr/sbin:/bin:/sbin
export PATH

DEBUG=false
rootdelay=

# FIX: mnt_tmp sebagai GLOBAL
mnt_tmp="/tmpmnt"
VENTOY_BOOT=false

log_msg() {
  local msg="[INIT] $*"
  if ! echo "$msg" > /dev/kmsg 2>/dev/null; then
    echo "$msg"
  fi
}

problem() {
  log_msg "ERROR: Problem detected!"
  printf "\nEncountered a problem!\nDropping to emergency shell...\n\n"
  printf "Useful commands: lsblk, blkid, ls, mount, dmesg\n\n"
  exec /bin/sh
}

# Cari init di berbagai lokasi umum
find_init() {
  for candidate in \
    /sbin/init \
    /usr/sbin/init \
    /usr/lib/systemd/systemd \
    /lib/systemd/systemd \
    /usr/lib/sysvinit/init \
    /bin/init \
    /bin/bash \
    /bin/sh
  do
    if [ -x "/.root${candidate}" ]; then
      echo "$candidate"
      return 0
    fi
  done
  return 1
}

# Auto-detect boot device - scan semua device termasuk virtual (virtio, sata, ide)
find_boot_device() {
  local timeout=90
  local count=0

  log_msg "Auto-detecting boot media (timeout: ${timeout}s)..."
  log_msg "Looking for /boot/lfs.squashfs on available devices..."

  mkdir -p "$mnt_tmp" 2>/dev/null

  # === VMWARE/VIRTUALBOX: Cek CDROM dari IDE/SATA ===
  log_msg "Checking for VMware/VirtualBox CDROM..."
  for cdrom in /dev/sr0 /dev/sr1 /dev/cdrom /dev/cdrw /dev/dvd; do
    if [ -b "$cdrom" ]; then
      log_msg "Testing CDROM: $cdrom"
      if mount -t iso9660 -o ro "$cdrom" "$mnt_tmp" 2>/dev/null; then
        if [ -f "$mnt_tmp/boot/lfs.squashfs" ]; then
          device="$cdrom"
          log_msg "Boot media DETECTED on $cdrom"
          return 0
        fi
        umount "$mnt_tmp" 2>/dev/null
      fi
    fi
  done

  # === VENTOY: ISO sudah di-mount oleh Ventoy sebelum init jalan ===
  log_msg "Checking for Ventoy pre-mounted paths..."
  for ventoy_mnt in /run/archiso/bootmnt /cdrom /run/live/medium /media/ventoy /run/initramfs/live; do
    if [ -f "${ventoy_mnt}/boot/lfs.squashfs" ]; then
      device="ventoy"
      mnt_tmp="$ventoy_mnt"
      VENTOY_BOOT=true
      log_msg "Ventoy boot detected: squashfs found at ${ventoy_mnt}/boot/lfs.squashfs"
      return 0
    fi
  done

  # === VENTOY: Cek disk by-label Ventoy ===
  if [ -b /dev/disk/by-label/Ventoy ]; then
    local vtdev
    vtdev=$(readlink -f /dev/disk/by-label/Ventoy 2>/dev/null)
    log_msg "Found Ventoy label on $vtdev, probing..."
    if [ -b "$vtdev" ] && mount -t auto -o ro "$vtdev" "$mnt_tmp" 2>/dev/null; then
      if [ -f "$mnt_tmp/boot/lfs.squashfs" ]; then
        device="$vtdev"
        VENTOY_BOOT=true
        log_msg "Boot media DETECTED via Ventoy label on $vtdev"
        return 0
      fi
      umount "$mnt_tmp" 2>/dev/null
    fi
  fi

  # === VIRTUALBOX/VMWARE: Cek SATA/SCSI/VirtIO disks ===
  log_msg "Checking for VirtualBox/VMware virtual disks..."
  
  # Tunggu device muncul (untuk USB boot)
  sleep 2
  
  # Scan semua block device, termasuk virtual
  while [ $count -lt $timeout ]; do
    # lsblk: ambil semua TYPE disk, part, rom (skip loop)
    for dev in $(lsblk -pnlo NAME,TYPE 2>/dev/null | awk '$2=="disk" || $2=="part" || $2=="rom" {print $1}'); do
      [ -b "$dev" ] || continue
      
      # Skip loop devices (tidak mungkin boot dari loop)
      case "$dev" in
        /dev/loop*) continue ;;
      esac
      
      log_msg "Probing $dev..."
      if mount -t auto -o ro "$dev" "$mnt_tmp" 2>/dev/null; then
        # Cek berbagai kemungkinan path squashfs
        if [ -f "$mnt_tmp/boot/lfs.squashfs" ]; then
          device="$dev"
          log_msg "Boot media DETECTED on $dev (found /boot/lfs.squashfs)"
          return 0
        elif [ -f "$mnt_tmp/lfs.squashfs" ]; then
          device="$dev"
          log_msg "Boot media DETECTED on $dev (found /lfs.squashfs)"
          return 0
        elif [ -f "$mnt_tmp/LiveOS/squashfs.img" ]; then
          # Alternative path untuk beberapa distro
          ln -sf "$mnt_tmp/LiveOS/squashfs.img" "$mnt_tmp/boot/lfs.squashfs" 2>/dev/null
          device="$dev"
          log_msg "Boot media DETECTED on $dev (found LiveOS/squashfs.img)"
          return 0
        fi
        umount "$mnt_tmp" 2>/dev/null
      fi
    done

    # Untuk USB, perlu waktu lebih lama
    if [ $count -eq 0 ]; then
      log_msg "Waiting for devices to settle..."
      sleep 3
    fi
    
    sleep 2
    count=$((count + 2))
    [ $((count % 10)) -eq 0 ] && log_msg "Still scanning... (${count}s)"
  done

  log_msg "ERROR: No valid boot media found after ${timeout}s"
  log_msg "Available devices:"
  lsblk -f 2>/dev/null || true
  blkid 2>/dev/null || true
  problem
  return 1
}

ensure_users() {
  log_msg "Ensuring user database exists in overlay..."

  if [ ! -f /.root/etc/passwd ] || [ ! -s /.root/etc/passwd ]; then
    log_msg "Creating minimal /etc/passwd in overlay..."
    cat > /.root/etc/passwd << 'EOF'
root:x:0:0:root:/root:/bin/bash
live:x:1000:1000:Live User:/home/live:/bin/bash
nobody:x:65534:65534:nobody:/nonexistent:/usr/sbin/nologin
EOF
  fi

  if [ ! -f /.root/etc/group ] || [ ! -s /.root/etc/group ]; then
    log_msg "Creating minimal /etc/group in overlay..."
    cat > /.root/etc/group << 'EOF'
root:x:0:
live:x:1000:
nogroup:x:65534:
EOF
  fi

  if [ ! -f /.root/etc/shadow ] || [ ! -s /.root/etc/shadow ]; then
    log_msg "Creating minimal /etc/shadow in overlay..."
    cat > /.root/etc/shadow << 'EOF'
root:*:19490:0:99999:7:::
live:$6$hrIle5KuazOX40Ge$aXM7O70/9.fvyVFD2IszFjz85qJsU/YGP2aRSkzQPVKtsOB47uXaA80NKGhSn92ZJ3RDNvC3IRnaTN8IbdodG.:19490:0:99999:7:::
nobody:*:19490:0:99999:7:::
EOF
    chmod 600 /.root/etc/shadow
  fi

  mkdir -p /.root/etc/pam.d
  cat > /.root/etc/pam.d/common-auth << 'EOF'
auth    sufficient      pam_unix.so nullok
auth    required        pam_deny.so
EOF

  if [ ! -d /.root/home/live ]; then
    log_msg "Creating home directory for live user with standard folders..."
    mkdir -p /.root/home/live
    mkdir -p /.root/home/live/{Desktop,Documents,Downloads,Music,Pictures,Videos,Public,Templates}
    mkdir -p /.root/home/live/{.local/share,.config,.cache,.ssh,.gnupg}
    mkdir -p /.root/home/live/{temp,bin}
    chown -R 1000:1000 /.root/home/live
    chmod 700 /.root/home/live
    chmod 755 /.root/home/live/{Desktop,Documents,Downloads,Music,Pictures,Videos,Public,Templates}
    chmod 700 /.root/home/live/{.ssh,.gnupg}
    log_msg "Created standard folders for live user"
  fi

  log_msg "User setup complete"
}

do_mount_root() {
  log_msg "Mounting root filesystem (squashfs + overlay)"

  # Load semua module yang diperlukan untuk berbagai platform
  modprobe -q squashfs 2>/dev/null || true
  modprobe -q overlay 2>/dev/null || true
  modprobe -q loop 2>/dev/null || true
  modprobe -q vfat 2>/dev/null || true
  modprobe -q iso9660 2>/dev/null || true
  modprobe -q isofs 2>/dev/null || true
  modprobe -q usb-storage 2>/dev/null || true
  modprobe -q sr_mod 2>/dev/null || true
  
  # VirtualBox modules
  modprobe -q vboxguest 2>/dev/null || true
  modprobe -q vboxsf 2>/dev/null || true
  
  # VMware modules
  modprobe -q vmw_balloon 2>/dev/null || true
  modprobe -q vmxnet3 2>/dev/null || true
  
  # VirtIO (KVM/QEMU)
  modprobe -q virtio 2>/dev/null || true
  modprobe -q virtio_pci 2>/dev/null || true
  modprobe -q virtio_blk 2>/dev/null || true
  modprobe -q virtio_net 2>/dev/null || true
  
  # USB controllers
  modprobe -q xhci_hcd 2>/dev/null || true
  modprobe -q ehci_hcd 2>/dev/null || true
  modprobe -q uhci_hcd 2>/dev/null || true
  
  # Network
  modprobe -q e1000 2>/dev/null || true
  modprobe -q e1000e 2>/dev/null || true
  modprobe -q pcnet32 2>/dev/null || true

  mkdir -p /.root /mnt /squash /cow
  mkdir -p /cow/upper /cow/work

  if ! find_boot_device; then
    return 1
  fi

  # Mount boot device ke /mnt
  if [ "$VENTOY_BOOT" = "true" ] && [ "$device" = "ventoy" ]; then
    log_msg "Ventoy mode: binding ${mnt_tmp} to /mnt"
    mount --bind "$mnt_tmp" /mnt 2>/dev/null || { log_msg "bind ventoy mount failed"; problem; }
  elif mountpoint -q "$mnt_tmp" 2>/dev/null; then
    mount --move "$mnt_tmp" /mnt 2>/dev/null || problem
  else
    mount -t auto "$device" /mnt 2>/dev/null || { log_msg "Mount $device failed"; problem; }
  fi
  log_msg "Boot media mounted at /mnt"

  # Cek berbagai kemungkinan lokasi squashfs
  SQUASH_PATH=""
  if [ -f /mnt/boot/lfs.squashfs ]; then
    SQUASH_PATH="/mnt/boot/lfs.squashfs"
  elif [ -f /mnt/lfs.squashfs ]; then
    SQUASH_PATH="/mnt/lfs.squashfs"
  elif [ -f /mnt/LiveOS/squashfs.img ]; then
    SQUASH_PATH="/mnt/LiveOS/squashfs.img"
  fi
  
  if [ -z "$SQUASH_PATH" ]; then
    log_msg "ERROR: squashfs file missing!"
    log_msg "Contents of /mnt:"
    ls -la /mnt/ 2>/dev/null || true
    log_msg "Contents of /mnt/boot:"
    ls -la /mnt/boot/ 2>/dev/null || true
    problem
  fi

  log_msg "Mounting squashfs from $SQUASH_PATH"
  mount -t squashfs -o loop "$SQUASH_PATH" /squash 2>/dev/null || {
    log_msg "Failed to mount squashfs!"
    problem
  }
  log_msg "squashfs mounted at /squash"

  mount -t tmpfs tmpfs /cow 2>/dev/null || problem
  mkdir -p /cow/upper /cow/work

  # Mount overlay
  log_msg "Mounting overlay filesystem..."
  mount -t overlay overlay -o lowerdir=/squash,upperdir=/cow/upper,workdir=/cow/work /.root 2>/dev/null || {
    log_msg "Overlay mount failed!"
    problem
  }
  log_msg "Overlay mounted at /.root"

  ensure_users

  # Bind pseudo-fs ke new root
  log_msg "Binding pseudo-filesystems to new root..."
  mount --move /dev  /.root/dev 2>/dev/null || log_msg "WARNING: move /dev failed"
  mount --move /proc /.root/proc 2>/dev/null || log_msg "WARNING: move /proc failed"
  mount --move /sys  /.root/sys 2>/dev/null || log_msg "WARNING: move /sys failed"
  mount --move /run  /.root/run 2>/dev/null || log_msg "WARNING: move /run failed"
  
  # Bind mount boot media ke dalam new root (optional)
  mkdir -p /.root/run/boot-media 2>/dev/null
  mount --bind /mnt /.root/run/boot-media 2>/dev/null || true

  log_msg "Root filesystem prepared!"
}

# ===================== MAIN =====================

log_msg "=== LFS Live ISO Init Starting ==="

# Setup basic directories
mkdir -p /proc /sys /dev /run /tmp 2>/dev/null

# Mount pseudo-filesystems dengan urutan yang benar
log_msg "Mounting pseudo-filesystems..."
mount -t devtmpfs devtmpfs /dev 2>/dev/null || { log_msg "devtmpfs failed"; /bin/sh; }
mount -t proc proc /proc 2>/dev/null || { log_msg "CRITICAL: proc mount failed!"; /bin/sh; }
mount -t sysfs sysfs /sys 2>/dev/null || log_msg "sysfs mount failed (non-fatal)"
mount -t tmpfs tmpfs /run 2>/dev/null || log_msg "tmpfs /run failed (non-fatal)"
mkdir -p /dev/pts 2>/dev/null
mount -t devpts devpts /dev/pts -o gid=5,mode=620 2>/dev/null || log_msg "devpts mount failed"

# Read kernel cmdline
if [ ! -r /proc/cmdline ]; then
  log_msg "WARNING: /proc/cmdline missing - remounting /proc"
  umount /proc 2>/dev/null
  mount -t proc proc /proc 2>/dev/null || { log_msg "Cannot remount /proc!"; /bin/sh; }
fi

cmdline=$(cat /proc/cmdline 2>/dev/null || echo "")
log_msg "Kernel cmdline: $cmdline"

for param in $cmdline; do
  case $param in
    debug)        DEBUG=true ;;
    rootdelay=*)  rootdelay=${param#rootdelay=} ;;
    ventoy*)      log_msg "Ventoy boot mode indicated by cmdline" ;;
  esac
done

# Start udev dengan aman (ignore setclock error)
log_msg "Starting udev..."

# Cari udevd
UDEVD=""
for p in /usr/bin/udevd /usr/sbin/udevd /sbin/udevd /lib/udev/udevd /usr/lib/udev/udevd /usr/lib/systemd/systemd-udevd; do
  if [ -x "$p" ]; then
    UDEVD="$p"
    break
  fi
done

if [ -z "$UDEVD" ]; then
  log_msg "WARNING: udevd not found, skipping udev"
else
  # Start udevd dengan opsi minimal
  $UDEVD --daemon 2>/dev/null || $UDEVD --daemon --resolve-names=never 2>/dev/null || true
  sleep 2
  
  # Cari udevadm
  UDEVADM=""
  for p in /usr/bin/udevadm /usr/sbin/udevadm /sbin/udevadm; do
    if [ -x "$p" ]; then
      UDEVADM="$p"
      break
    fi
  done
  
  if [ -n "$UDEVADM" ]; then
    # Trigger udev events tanpa error
    $UDEVADM trigger --action=add --type=subsystems 2>/dev/null || true
    $UDEVADM trigger --action=add --type=devices 2>/dev/null || true
    $UDEVADM settle --timeout=10 2>/dev/null || true
    log_msg "udev ready"
  else
    log_msg "WARNING: udevadm not found"
  fi
fi

# Apply rootdelay if specified
if [ -n "$rootdelay" ]; then
  log_msg "rootdelay ${rootdelay}s"
  sleep "$rootdelay"
fi

# Mount root filesystem
do_mount_root || problem

# Stop udev before switch_root
log_msg "Stopping udev..."
if [ -n "$UDEVD" ]; then
  killall -q udevd 2>/dev/null || killall -q systemd-udevd 2>/dev/null || true
fi

# Find and execute init
INIT_PATH=$(find_init)
if [ -z "$INIT_PATH" ]; then
  log_msg "FATAL: No valid init found in /.root!"
  log_msg "Available executables in /sbin:"
  ls -la /.root/sbin/ 2>/dev/null | head -20 || true
  log_msg "Available executables in /usr/sbin:"
  ls -la /.root/usr/sbin/ 2>/dev/null | head -20 || true
  problem
fi

log_msg "Switching to new root with init: $INIT_PATH"
exec switch_root /.root "$INIT_PATH" "$@"

log_msg "FATAL: switch_root failed!"
problem
